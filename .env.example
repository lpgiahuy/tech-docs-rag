# Copy to .env and fill in.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5434/postgres
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
# Tried in order when LLM_MODEL is out of quota, overloaded or gone. Empty = no fallback.
LLM_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=50
# vector | keyword | hybrid. keyword and hybrid need the content_tsv column (sql/init.sql).
RETRIEVAL_MODE=vector
# Rerank the top 20 candidates with a cross-encoder (better on exact terms, much slower).
RERANK=false

# Used by docker compose for the database container and the API connection string.
# Choose a strong password on a server; the default is only for local development.
POSTGRES_PASSWORD=postgres
